! Reference CP2K QM/MM input snippet for GROMACS-CP2K using tblite (GFN2-xTB)
! and Ewald electrostatic embedding (&QMMM).
! Note: When coupled with GROMACS (qmmm-cp2k-active = true), GROMACS supplies
! the &SUBSYS coordinates, cell, &QM_KIND, and &MM_KIND sections automatically,
! or merges with a custom CP2K input template via qmmm-cp2k-qmfilenames.

&GLOBAL
  PROJECT qmmm_gfn2_xtb
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD QMMM

  &DFT
    CHARGE 0
    MULTIPLICITY 1
    &QS
      METHOD xTB
      &XTB
        &TBLITE T
          METHOD GFN2
        &END TBLITE
      &END XTB
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 100
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF

    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
      &EWALD
        EWALD_TYPE SPME
        GMAX 25
      &END EWALD
    &END POISSON
  &END DFT

  &MM
    &FORCEFIELD
      DO_NONBONDED FALSE
    &END FORCEFIELD
    &POISSON
      &EWALD
        EWALD_TYPE SPME
        GMAX 25
      &END EWALD
    &END POISSON
  &END MM

  &QMMM
    ECOUPL COULOMB
    USE_GEEP_LIB 12
    &CELL
      ABC 20.0 20.0 20.0
    &END CELL
    ! Define QM atoms by 1-based MM_INDEX (example):
    ! &QM_KIND O
    !   MM_INDEX 1
    ! &END QM_KIND
  &END QMMM
  &SUBSYS
    &CELL
      ABC 20.0 20.0 20.0
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME qmmm_input.pdb
      COORD_FILE_FORMAT PDB
      CHARGE_EXTENDED TRUE
      CONN_FILE_FORMAT OFF
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
